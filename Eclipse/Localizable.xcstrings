            "state": "translated",
            "value": "Bu videonun medya kimliği bulunmadığından birlikte izleme kullanılamıyor."
          }
        }
      }
    },
    "Starting secure Watch Together with SharePlay...": {
      "localizations": {
        "tr": {
          "stringUnit": {
