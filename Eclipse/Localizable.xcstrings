    "Choose a stream to %@. %lld of the %lld streams Eclipse kept are hidden by your stream filters or are not usable for this action.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a stream to %1$@. %2$lld of the %3$lld streams Eclipse kept are hidden by your stream filters or are not usable for this action."
          }
        },
