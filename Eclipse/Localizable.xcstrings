    "Automatically keep selected Eclipse data in sync through iCloud, Google Drive, or OneDrive.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen Eclipse verilerini iCloud, Google Drive veya OneDrive aracılığıyla otomatik eşitler."
          }
        }
      }
    },
    "Available": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanılabilir"
          }
        }
      }
    },
    "Available only when playing with MPV's MoltenVK renderer. The player button stays hidden in AVPlayer and while this setting is off.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca MPV'nin MoltenVK oynatıcısında kullanılabilir. AVPlayer'da ve bu ayar kapalıyken oynatıcı düğmesi gizlenir."
          }
        }
      }
    },
    "Avatar color %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avatar rengi %@"
          }
        }
