            "value": "Geçmişi temizle"
          }
        }
      }
    },
    "Clear History?": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmiş temizlensin mi?"
          }
        }
      }
    },
    "Clear Included Languages": {
      "localizations": {
