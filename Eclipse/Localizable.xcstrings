    "Auto": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik"
          }
        }
      }
    },
    "Auto Download": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik indir"
          }
        }
      }
    },
    "Auto Mode checks included, enabled sources from top to bottom. Drag to set priority. Include All and Exclude All also update installed sources that are currently disabled on this device, without changing sources that exist only on another platform.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik mod, dahil edilmiş etkin kaynakları yukarıdan aşağıya kontrol eder. Önceliği sürükleyerek ayarlayın. Tümünü dahil et veya hariç tut, bu cihazda devre dışı bırakılmış kurulu kaynakları da günceller; yalnızca başka bir platformda bulunan kaynakları değiştirmez."
          }
        }
      }
    },
    "Auto Mode checks included, enabled sources from top to bottom. Use the arrow buttons to set priority. Include All and Exclude All also update installed sources that are currently disabled on this Apple TV, without changing sources that exist only on another platform.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik mod, dahil edilmiş etkin kaynakları yukarıdan aşağıya kontrol eder. Önceliği ok düğmeleriyle ayarlayın. Tümünü dahil et veya hariç tut, bu Apple TV'de devre dışı bırakılmış kurulu kaynakları da günceller; yalnızca başka bir platformda bulunan kaynakları değiştirmez."
          }
        }
      }
    },
    "Auto Mode Error Intelligence": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik mod hata yönetimi"
          }
        }
      }
    },
    "Auto-Select Episodes also applies when choosing a source manually.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bölümleri otomatik seçme, kaynak elle seçildiğinde de uygulanır."
          }
        }
      }
    },
    "Auto-Update Sources": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynakları otomatik güncelle"
          }
        }
      }
    },
    "Automatically check for source updates when the app is opened.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama açıldığında kaynak güncellemelerini otomatik kontrol eder."
