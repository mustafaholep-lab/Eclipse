          }
        }
      }
    },
    "These are %@'s own filters. Whatever is selected here is what the Discover row loads.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are %@'s own filters. Whatever is selected here is what the Discover row loads."
