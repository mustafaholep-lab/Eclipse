    "Seeks to the end of this segment.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu segmentin sonuna gider."
          }
        }
      }
    },
    "Eclipse detected bad thermal state, protecting device": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eclipse yüksek sıcaklık algıladı; cihaz korunuyor"
          }
        }
      }
    },
    "Watch Together needs this episode's exact anime identity. Open it from the show page so everyone can move together.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birlikte izleme için bu bölümün kesin anime kimliği gerekir. Herkesin birlikte ilerlemesi için dizinin sayfasından açın."
          }
        }
      }
    },
    "Watch Together changed before the next episode was ready. Sync the session and try again.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki bölüm hazır olmadan birlikte izleme değişti. Oturumu eşitleyip yeniden deneyin."
          }
        }
      }
    },
    "The next episode is still resolving. Try again in a moment so everyone moves together.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki bölüm hâlâ çözümleniyor. Herkesin birlikte ilerlemesi için biraz sonra yeniden deneyin."
          }
