    "Next Episode": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki bölüm"
          }
        }
      }
    },
    "Closes this player, then opens the next episode.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oynatıcıyı kapatıp sonraki bölümü açar."
          }
        }
      }
    },
    "Returns to the current episode without opening the next one.": {
      "localizations": {
