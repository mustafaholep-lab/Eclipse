      }
    },
    "At least one grown-up profile has to stay. Kids profiles can't add, edit, or delete profiles, so turning this one into a kids profile would leave nobody able to change it back.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En az bir yetişkin profili kalmalıdır. Çocuk profilleri profil ekleyemez, düzenleyemez veya silemez. Bunu çocuk profiline dönüştürmek, geri değiştirebilecek kimseyi bırakmaz."
          }
        }
      }
    },
    "Atmosphere": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atmosfer"
          }
        }
      }
    },
