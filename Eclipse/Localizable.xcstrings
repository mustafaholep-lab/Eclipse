    "Every profile uses the same Services, Stremio addons, and stream rules. Turn this off to give each profile its own setup. The current setup is copied the first time a profile needs it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every profile uses the same Services, Stremio addons, and stream rules. Turn this off to give each profile its own setup. The current setup is copied the first time a profile needs it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm profiller aynı hizmetleri, Stremio eklentilerini ve yayın kurallarını kullanır. Her profile ayrı ayar vermek için bunu kapatın. Bir profil ilk kez ihtiyaç duyduğunda geçerli ayarlar kopyalanır."
          }
        }
      }
    },
    "Every profile uses the same services, Stremio addons, plugins, and stream rules. Turn this off to give each profile its own — the current setup is copied across the first time a profile needs it, and they go their own way from there.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every profile uses the same services, Stremio addons, plugins, and stream rules. Turn this off to give each profile its own — the current setup is copied across the first time a profile needs it, and they go their own way from there."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm profiller aynı hizmetleri, eklentileri ve yayın kurallarını kullanır. Her profile ayrı ayar vermek için bunu kapatın; geçerli ayarlar ilk ihtiyaçta kopyalanır ve sonrasında birbirinden bağımsız olur."
          }
        }
      }
    },
