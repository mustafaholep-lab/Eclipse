    "\"%@\" and its saved items will be removed from your library.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" and its saved items will be removed from your library."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" ve kayıtlı öğeleri kitaplığınızdan kaldırılacak."
          }
        }
      }
    },
    "\"%@\" does not have a TMDB entry and cannot be opened.": {
      "localizations": {
