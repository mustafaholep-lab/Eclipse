    "Drag rows to change their order. Hidden rows will not appear on manga, manhwa, or light novel detail pages.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag rows to change their order. Hidden rows will not appear on manga, manhwa, or light novel detail pages."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıralamayı değiştirmek için satırları sürükleyin. Gizli satırlar manga, manhwa ve hafif roman ayrıntı sayfalarında görünmez."
          }
        }
      }
    },
    "Drag rows to change their order. Hidden rows will not appear on media detail pages. Episodes only appear for series. Stills and Trailers appear in the Modern interface.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag rows to change their order. Hidden rows will not appear on media detail pages. Episodes only appear for series. Stills and Trailers appear in the Modern interface."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıralamayı değiştirmek için satırları sürükleyin. Gizli satırlar medya ayrıntı sayfalarında görünmez. Bölümler yalnızca dizilerde; kareler ve fragmanlar Modern arayüzde görünür."
          }
        }
      }
    },
    "Drop Unmatched Search Results": {
      "localizations": {
