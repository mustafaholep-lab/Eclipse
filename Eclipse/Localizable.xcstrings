          }
        }
      }
    },
    "Choose a verified VOD stream to %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ için doğrulanmış bir VOD yayını seçin"
          }
        }
      }
    },
    "Choose a verified VOD stream to %@. %lld of the %lld streams Eclipse kept are hidden by your stream filters or are not usable for this action.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ için doğrulanmış bir VOD yayını seçin. Eclipse'in tuttuğu yayınların %lld / %lld kadarı filtrelerinizce gizlenmiş veya bu işlem için kullanılamıyor."
          }
        }
      }
    },
    "Choose an optional way to support Eclipse.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eclipse'i desteklemek için isteğe bağlı bir yöntem seçin."
          }
        }
      }
    },
    "Choose how Eclipse automatically selects sources, episodes, and stream quality.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eclipse'in kaynakları, bölümleri ve yayın kalitesini otomatik nasıl seçeceğini ayarlayın."
          }
        }
      }
    },
    "Choose Source": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynak seçin"
          }
        }
      }
    },
    "Choose the correct episode for S%lldE%lld:": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "S%lldB%lld için doğru bölümü seçin:"
          }
        }
      }
    },
    "Choose what Eclipse should check for on this device.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eclipse'in bu cihazda neleri kontrol edeceğini seçin."
          }
        }
      }
    },
    "CLEAR": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TEMİZLE"
          }
        }
      }
    },
    "Clear All": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tümünü temizle"
          }
        }
      }
    },
    "Clear all observed history and remove Eclipse alerts from iOS Notification Center?": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm gözlemlenen geçmiş temizlensin ve Eclipse bildirimleri iOS Bildirim Merkezi'nden kaldırılsın mı?"
          }
        }
      }
    },
    "Clear Authentication": {
