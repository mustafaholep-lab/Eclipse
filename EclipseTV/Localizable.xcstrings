    "AniList is currently unavailable. Eclipse will use MyAnimeList for anime metadata and AnimeSchedule for episode schedules when available. Schedules may be incomplete or out of date, and season or special mappings may be less accurate until AniList recovers.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AniList is currently unavailable. Eclipse will use MyAnimeList for anime metadata and AnimeSchedule for episode schedules when available. Schedules may be incomplete or out of date, and season or special mappings may be less accurate until AniList recovers."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AniList şu anda kullanılamıyor. Eclipse, mümkün olduğunda anime bilgileri için MyAnimeList'i, bölüm takvimleri için AnimeSchedule'ı kullanacak. AniList düzelene kadar takvimler eksik veya güncelliğini yitirmiş, sezon ve özel bölüm eşleştirmeleri daha az doğru olabilir."
          }
        }
      }
    },
