            "value": "Kaynaklar"
          }
        }
      }
    },
    "Split Wide Images": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geniş görselleri böl"
          }
        }
      }
    },
    "Start Reading": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okumaya başla"
          }
        }
      }
