    "Showing the first %lld ranked streams.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk %lld sıralanmış yayın gösteriliyor."
          }
        }
      }
    },
    "Shows one compact, filterable list of results and streams instead of grouping them into separate source sections.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonuç ve yayınları ayrı kaynak bölümleri yerine küçük, filtrelenebilir tek bir listede gösterir."
          }
        }
      }
    },
    "Sign In": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş yap"
          }
        }
      }
    },
    "Sign-in pages run in an isolated browser. Eclipse routes their web requests through this source's approved-domain and private-network protections, stores matching server cookies only on this device, and does not share cookies between approved domains.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş sayfaları ayrı bir tarayıcıda çalışır. Eclipse web isteklerini kaynağın onaylı alan adı ve özel ağ korumalarından geçirir; eşleşen sunucu çerezlerini yalnızca bu cihazda tutar ve onaylı alan adları arasında paylaşmaz."
          }
        }
      }
    },
    "Single": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek"
          }
        }
      }
    },
    "Skip AniList Traversal for Anime Details": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anime ayrıntılarında AniList taramasını atla"
          }
        }
      }
    },
    "Skipped unavailable sources: %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanılamayan kaynaklar atlandı: %@"
          }
        }
      }
    },
    "SkyStream Error": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SkyStream hatası"
          }
        }
      }
    },
    "SkyStream Plugins": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SkyStream eklentileri"
          }
        }
      }
    },
    "Solid Color Source": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düz renk kaynağı"
          }
        }
      }
