        }
      }
    },
    "You joined the Watch Together session, but the host's Eclipse hasn't responded yet. Ask them to open Eclipse with their video playing.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birlikte izleme oturumuna katıldınız ancak sunucunun Eclipse'i henüz yanıt vermedi. Videoları oynarken Eclipse'i açmalarını isteyin."
