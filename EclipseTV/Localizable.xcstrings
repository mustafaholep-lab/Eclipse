    "Sign-in pages run in an isolated browser. Eclipse routes their web requests through this source's approved-domain and private-network protections, stores matching server cookies only on this device, and does not share cookies between approved domains.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in pages run in an isolated browser. Eclipse routes their web requests through this source's approved-domain and private-network protections, stores matching server cookies only on this device, and does not share cookies between approved domains."
          }
        },
        "tr": {
          "stringUnit": {
