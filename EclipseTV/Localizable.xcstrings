    "You closed the shared title while SharePlay is still active. Leaving stops syncing with the group on this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You closed the shared title while SharePlay is still active. Leaving stops syncing with the group on this device."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SharePlay hâlâ etkinken paylaşılan yapımı kapattınız. Ayrılmak bu cihazdaki grup eşitlemesini durdurur."
          }
        }
      }
    },
    "You don't have any active %@. Add or enable a source in Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have any active %@. Add or enable a source in Settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin %@ yok. Ayarlar'dan kaynak ekleyin veya etkinleştirin."
          }
        }
      }
    },
    "You don't have any active services, Stremio addons, or plugins. Add or enable a source in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have any active services, Stremio addons, or plugins. Add or enable a source in Settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin hizmet, Stremio eklentisi veya başka eklenti yok. Ayarlar'dan kaynak ekleyin veya etkinleştirin."
          }
        }
      }
    },
    "You don't have any active sources. Open Services settings to add or enable one.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have any active sources. Open Services settings to add or enable one."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin kaynağınız yok. Hizmetler ayarlarından kaynak ekleyin veya etkinleştirin."
          }
        }
      }
    },
    "You joined the Watch Together session, but the host's Eclipse hasn't responded yet. Ask them to open Eclipse with their video playing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You joined the Watch Together session, but the host's Eclipse hasn't responded yet. Ask them to open Eclipse with their video playing."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birlikte izleme oturumuna katıldınız ancak sunucunun Eclipse'i henüz yanıt vermedi. Videoları oynarken Eclipse'i açmalarını isteyin."
          }
        }
      }
    },
    "Your name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your name"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adınız"
          }
        }
      }
    },
    "Your Other Devices": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Other Devices"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer cihazlarınız"
          }
        }
      }
    },
    "Your profiles came back with your data. Pick the one to open Eclipse with.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your profiles came back with your data. Pick the one to open Eclipse with."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilleriniz verilerinizle geri geldi. Eclipse'i açmak için birini seçin."
          }
        }
      }
    },
    "Your settings may have changed on this device while syncing was off. \"Use My Other Devices\" replaces this device's settings with the ones already shared across your account. \"Use This Device\" makes these settings the shared ones and updates your other devices. Settings sync stays off until you choose.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your settings may have changed on this device while syncing was off. \"Use My Other Devices\" replaces this device's settings with the ones already shared across your account. \"Use This Device\" makes these settings the shared ones and updates your other devices. Settings sync stays off until you choose."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşitleme kapalıyken bu cihazdaki ayarlar değişmiş olabilir. Diğer cihazlarımı kullan, buradaki ayarları hesabınızda zaten paylaşılanlarla değiştirir. Bu cihazı kullan, bu ayarları ortak ayarlar yaparak diğer cihazlarınızı günceller. Siz seçene kadar ayar eşitleme kapalı kalır."
          }
        }
      }
    },
