    "Status": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durum"
          }
        }
      }
    },
    "Step %lld of %lld": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adım %lld / %lld"
          }
        }
