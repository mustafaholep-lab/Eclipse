    "Available": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanılabilir"
          }
        }
      }
    },
    "Available only when playing with MPV's MoltenVK renderer. The player button stays hidden in AVPlayer and while this setting is off.": {
      "localizations": {
        "tr": {
