    },
    "Stop": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durdur"
          }
        }
      }
    },
    "Storage Used: %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanılan alan: %@"
          }
        }
      }
    },
    "Stream URLs, request headers, cookies, subtitles, and provider credentials never leave your device.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayın URL'leri, istek başlıkları, çerezler, altyazılar ve sağlayıcı kimlik bilgileri cihazınızdan çıkmaz."
          }
        }
      }
    },
    "Stremio Addons": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stremio eklentileri"
          }
        }
      }
    },
    "Stremio-Style Stream List": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stremio tarzı yayın listesi"
          }
        }
      }
    },
    "Suggested": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önerilen"
          }
        }
      }
    },
    "Support Eclipse": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eclipse'i destekle"
          }
        }
      }
    },
    "Switch to Media Mode": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Medya moduna geç"
          }
        }
      }
    },
    "Sync Accounts Now": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesapları şimdi eşitle"
          }
        }
      }
    },
    "Sync Health": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşitleme sağlığı"
          }
        }
      }
    },
    "Sync Now": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi eşitle"
          }
        }
      }
    },
    "Sync Settings Across Devices": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarları cihazlar arasında eşitle"
          }
        }
      }
    },
    "Sync with iCloud": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ile eşitle"
          }
        }
      }
    },
    "Syncing Accounts…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesaplar eşitleniyor…"
          }
        }
      }
    },
    "System": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem"
          }
        }
      }
    },
    "Tap the \"+\" button to add a module": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modül eklemek için \"+\" düğmesine dokunun"
          }
        }
      }
    },
    "Tap the handle on the edge of the screen.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekranın kenarındaki tutamağa dokunun."
          }
        }
      }
    },
    "Tap to expand or collapse media details": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Medya ayrıntılarını açmak veya daraltmak için dokunun"
          }
        }
      }
    },
    "Tap Zones": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokunma bölgeleri"
          }
        }
      }
    },
    "Technical Details": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teknik ayrıntılar"
          }
        }
      }
    },
    "Text": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metin"
          }
        }
      }
    },
    "Text Alignment": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metin hizalama"
          }
        }
      }
    },
    "The details needed to check this title didn't load, so it stays hidden for now.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yapımı kontrol etmek için gerekli ayrıntılar yüklenemedi; şimdilik gizli kalacak."
          }
        }
      }
    },
    "The repository changed %@. Review its index and website before accepting.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depo %@ bilgisini değiştirdi. Kabul etmeden önce dizinini ve web sitesini inceleyin."
          }
        }
      }
    },
    "The stream list layout, language, quality, and source rules. These are shared by everyone on this device, so a kids profile cannot change them. Switch to a grown-up profile to make those changes.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayın listesi düzeni, dil, kalite ve kaynak kuralları bu cihazdaki herkes için ortaktır; çocuk profili bunları değiştiremez. Değiştirmek için yetişkin profiline geçin."
          }
        }
      }
    },
    "Theme Color": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema rengi"
          }
        }
      }
    },
    "These are %@'s own filters. Whatever is selected here is what the Discover row loads.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar %@ kaynağının kendi filtreleridir. Keşfet satırı burada seçilenleri yükler."
          }
        }
      }
    },
    "These stay in your library with a badge so you can spot them. Install a source that matches and Eclipse reconnects them for you.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolayca fark etmeniz için kitaplığınızda rozetle tutulur. Eşleşen bir kaynak kurduğunuzda Eclipse yeniden bağlar."
          }
        }
      }
    },
    "This changes the package's pinned source, installs an older version, or replaces code without a version change. Existing code stays installed unless the replacement fully validates.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem paketin sabitlenmiş kaynağını değiştirir, eski sürüm kurar veya sürüm değişmeden kodu değiştirir. Yeni kod tamamen doğrulanmadıkça mevcut kod kurulu kalır."
          }
        }
      }
    },
    "This clears Nuvio repositories, provider settings, repair history, and code owned only by the current Services profile. Other profiles' referenced code is preserved.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem yalnızca geçerli Hizmetler profilinin Nuvio depolarını, sağlayıcı ayarlarını, onarım geçmişini ve ona ait kodu temizler. Diğer profillerin kullandığı kod korunur."
          }
        }
      }
    },
    "This Device Only": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu cihaz"
          }
        }
      }
    },
    "This device's media state needs recovery. Cloud uploads are paused and incoming sync is held to protect your other devices.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazdaki medya durumunun kurtarılması gerekiyor. Diğer cihazları korumak için buluta yükleme duraklatıldı ve gelen eşitleme bekletiliyor."
          }
        }
      }
    },
    "This is a kids profile, so it can see this plugin but not change or remove it. Switch to a grown-up profile to make those changes.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çocuk profili bu eklentiyi görebilir ancak değiştiremez veya kaldıramaz. Değiştirmek için yetişkin profiline geçin."
          }
        }
      }
    },
    "This is a kids profile, so it cannot add, edit, or remove profiles. Switch to a grown-up profile to make those changes.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çocuk profili profil ekleyemez, düzenleyemez veya kaldıramaz. Değiştirmek için yetişkin profiline geçin."
          }
        }
      }
    },
    "This is a kids profile, so it cannot connect or disconnect trackers or import libraries. Switch to a grown-up profile to make those changes.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çocuk profili takip hizmetlerini bağlayamaz, bağlantısını kesemez veya kitaplık aktaramaz. Değiştirmek için yetişkin profiline geçin."
          }
        }
      }
    },
    "This one came from an older source that Eclipse no longer uses, so it can't load chapters right now.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu öğe Eclipse'in artık kullanmadığı eski bir kaynaktan geldiği için şu anda bölümleri yüklenemiyor."
          }
        }
      }
    },
    "This package is pinned to a different source, is older, or changed code without a version bump. Existing code remains installed unless the replacement fully validates.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu paket farklı bir kaynağa sabitlenmiş, daha eski veya sürüm artırılmadan kodu değiştirilmiş. Yeni paket tamamen doğrulanmadıkça mevcut kod kurulu kalır."
          }
        }
      }
    },
    "This package runs third-party JavaScript and has not completed Eclipse compatibility testing. Eclipse will still isolate its storage, filter network access, verify package integrity, and reject non-VOD output.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu paket üçüncü taraf JavaScript çalıştırır ve Eclipse uyumluluk testini tamamlamamıştır. Eclipse yine de depolamasını ayırır, ağ erişimini filtreler, paket bütünlüğünü doğrular ve VOD olmayan çıktıları reddeder."
          }
        }
      }
    },
    "This removes entries from History without clearing read chapters or library items.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okunmuş bölümleri veya kitaplık öğelerini temizlemeden geçmiş kayıtlarını kaldırır."
          }
        }
      }
    },
    "This removes every saved SkyStream repository and installed package from this device. You can add them again afterwards.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazdaki tüm kayıtlı SkyStream depolarını ve kurulu paketlerini kaldırır. Sonradan yeniden ekleyebilirsiniz."
          }
        }
      }
    },
    "This removes temporary artwork, metadata, and player files. Your local library and remote iCloud copy are not deleted.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçici görselleri, içerik bilgilerini ve oynatıcı dosyalarını kaldırır. Yerel kitaplığınız ve uzak iCloud kopyanız silinmez."
          }
        }
      }
    },
    "This removes temporary artwork, metadata, and player files. Your local library and the remote iCloud copy are not changed while sync is off.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçici görselleri, içerik bilgilerini ve oynatıcı dosyalarını kaldırır. Eşitleme kapalıyken yerel kitaplık ve uzak iCloud kopyası değiştirilmez."
          }
        }
      }
    },
    "This removes temporary artwork, metadata, player files, and the local sync cache. It refetches media state without creating CloudKit deletion records or removing the remote library.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçici görselleri, içerik bilgilerini, oynatıcı dosyalarını ve yerel eşitleme önbelleğini kaldırır. CloudKit silme kaydı oluşturmadan ve uzak kitaplığı kaldırmadan medya durumunu yeniden alır."
          }
        }
      }
    },
    "This removes temporary artwork, metadata, player files, and the local sync cache. Your remote iCloud library is not deleted.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçici görselleri, içerik bilgilerini, oynatıcı dosyalarını ve yerel eşitleme önbelleğini kaldırır. Uzak iCloud kitaplığınız silinmez."
          }
        }
      }
    },
    "This removes the plugin, every sub-provider row, stored preferences, and its local payload.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eklentiyi, tüm alt sağlayıcı satırlarını, kayıtlı tercihlerini ve yerel verilerini kaldırır."
          }
        }
      }
    },
    "This repository is no longer installed.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu depo artık kurulu değil."
          }
        }
      }
    },
    "This row appears on Discover under %@ and reloads with the home feed.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu satır Keşfet'te %@ altında görünür ve ana sayfa akışıyla yenilenir."
          }
        }
      }
    },
    "This source does not expose advanced filters.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kaynak gelişmiş filtre sunmuyor."
          }
        }
      }
    },
    "This source does not expose filters. The catalog will hold everything it returns.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kaynak filtre sunmuyor. Katalog, kaynağın döndürdüğü her şeyi içerir."
          }
        }
      }
    },
    "This source is blocked.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kaynak engellendi."
          }
        }
      }
    },
    "This source is missing device-local approval for %lld declared domain%@. Review them to restore its network access for this profile and device.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kaynak için bildirilen %lld alan adı%@ cihazda onaylanmamış. Bu profil ve cihazda ağ erişimini geri açmak için inceleyin."
          }
        }
      }
    },
    "This source is no longer installed.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kaynak artık kurulu değil."
          }
        }
      }
    },
    "This source's filters do not match any built-in catalog.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kaynağın filtreleri yerleşik kataloglarla eşleşmiyor."
          }
        }
      }
    },
    "This third-party package has not completed Eclipse compatibility testing. Install only if you trust its source.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu üçüncü taraf paket Eclipse uyumluluk testini tamamlamadı. Yalnızca kaynağına güveniyorsanız kurun."
          }
        }
      }
    },
    "This title is restricted for the profile you're using.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yapım, kullandığınız profil için kısıtlanmıştır."
          }
        }
      }
    },
    "Threshold (0.5 - 1.0)": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşik (0,5–1,0)"
          }
        }
      }
    },
    "Times shown in UTC": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatler UTC olarak gösterilir"
          }
        }
      }
    },
    "Times shown locally": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatler yerel olarak gösterilir"
          }
        }
      }
    },
    "Tips": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İpuçları"
          }
        }
      }
    },
    "Title Contains": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlık şunu içerir"
          }
        }
      }
    },
    "Toggles this title in the collection.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yapımın koleksiyona dahil edilmesini değiştirir."
          }
        }
      }
    },
    "Trakt sign-in code": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trakt giriş kodu"
          }
        }
      }
    },
    "Treat Dubbed Anime Streams as English": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
