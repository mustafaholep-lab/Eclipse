        }
      }
    },
    "Checking %@ streams against Extra Source Settings…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ yayınları ek kaynak ayarlarına göre kontrol ediliyor…"
